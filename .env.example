# Server-side only (used by api/venues.ts). Set in the Vercel project, never in client code.
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash
GEMINI_MODEL=
# Feedback form (api/feedback.ts): the Mindmaker OS Supabase project URL and its publishable key.
# The key can only call submit_product_feedback; it cannot read the table.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
