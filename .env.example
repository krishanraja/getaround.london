# Server-side only (used by api/venues.ts). Set in the Vercel project, never in client code.
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash
GEMINI_MODEL=
# Feedback form (api/feedback.ts), server-side only. The Control Center route that stores one note,
# and a bearer that allows only that one write. No database address or key lives in this app.
FEEDBACK_FORWARD_URL=
FEEDBACK_FORWARD_BEARER=
